# GitHub API token
GITHUB_TOKEN=

# Optional legacy fallback only. Managed-project Issues use projects.json -> issues_repo.
# ORCH_CONTROL_REPO=huyker/orchestrator

# Project registry and local runtime cache
ORCH_PROJECT_REGISTRY=projects.json
ORCH_RUNTIME_DIR=.orchestrator-runtime
ORCH_WORKSPACE_ROOT=.orchestrator-runtime/repos

# Scheduler/runtime
ORCH_POLL_INTERVAL=5
ORCH_SYNC_INTERVAL=15
ORCH_LEASE_TIMEOUT=90
ORCH_AGENT_TIMEOUT=1800
ORCH_TEST_TIMEOUT=600
ORCH_AGY_BIN=agy
ORCH_AGENT_EFFORT=medium
# Optional. If omitted, owners are inferred from projects.json (for example huyker/game -> huyker).
# ORCH_ALLOWED_AUTHORS=huyker

# Git transport for target project clones
ORCH_GIT_TRANSPORT=ssh

# Local-only dashboard
ORCH_DASHBOARD_HOST=127.0.0.1
ORCH_DASHBOARD_PORT=8766
ORCH_OPEN_BROWSER=1
